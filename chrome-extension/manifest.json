{
  "manifest_version": 3,
  "name": "Code Server Spawn",
  "version": "3.1",
  "description": "Launch code-server instances, auto-group tabs by repo, reconnect dead sessions",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open code-server (Cmd+Shift+.)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Open code-server launcher"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
