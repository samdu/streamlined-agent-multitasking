{
  "manifest_version": 3,
  "name": "Code Server Spawn",
  "version": "2.0",
  "description": "Launch code-server instances and auto-group tabs by repo",
  "permissions": ["tabs", "tabGroups", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open code-server (Cmd+Shift+.)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Open code-server launcher"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
